<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>মোবাইল ডকুমেন্ট এডিটর</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Noto Sans Bengali",sans-serif;background:#f0f2f5;color:#1a1a1a;height:100vh;overflow:hidden}
.app-container{display:flex;flex-direction:column;height:100vh;max-width:100%;margin:0 auto;background:#fff}
.app-header{display:flex;align-items:center;justify-content:space-between;padding:10px 12px;background:linear-gradient(135deg,#1a73e8,#0d47a1);color:#fff;box-shadow:0 2px 8px rgba(0,0,0,.15);z-index:100}
.app-header h1{font-size:1.1rem;font-weight:600}
.header-actions{display:flex;gap:6px}
.icon-btn{background:rgba(255,255,255,.2);border:none;color:#fff;padding:8px 10px;border-radius:8px;font-size:.85rem;cursor:pointer;min-height:40px;min-width:42px}
.icon-btn.primary{background:#34a853;font-weight:600}
.icon-btn.pdf{background:#ea4335;font-weight:600}
.icon-btn:active{transform:scale(.95)}
.toolbar{background:#f8f9fa;border-bottom:1px solid #dadce0;padding:6px 4px;overflow-x:auto;-webkit-overflow-scrolling:touch;z-index:90}
.toolbar-row{display:flex;flex-wrap:nowrap;gap:4px;padding:4px 0;justify-content:flex-start}
.tool-btn{background:#fff;border:1px solid #dadce0;border-radius:8px;padding:8px 10px;font-size:.85rem;min-height:40px;min-width:40px;cursor:pointer;white-space:nowrap;box-shadow:0 1px 2px rgba(0,0,0,.05)}
.tool-btn:active,.tool-btn.active{background:#e8f0fe;border-color:#1a73e8;color:#1a73e8}
.tool-select{border:1px solid #dadce0;border-radius:8px;padding:6px 8px;font-size:.85rem;min-height:40px;background:#fff}
.color-picker{width:40px;height:40px;border:1px solid #dadce0;border-radius:8px;padding:2px;cursor:pointer;background:#fff}
.table-tools{background:#e8f5e9;border-radius:8px;padding:4px;margin-top:2px}
.editor-wrapper{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:12px;background:#e8eaed}
.editor{min-height:100%;background:#fff;border-radius:8px;padding:20px 16px;box-shadow:0 1px 4px rgba(0,0,0,.1);outline:none;line-height:1.6;font-size:16px;word-wrap:break-word}
.editor:empty:before{content:attr(data-placeholder);color:#9aa0a6;pointer-events:none}
.editor table{border-collapse:collapse;width:100%;margin:12px 0;table-layout:fixed;border:2px solid #000}
.editor table td,.editor table th{border:1.5px solid #000;padding:10px 8px;min-width:40px;min-height:36px;vertical-align:top;word-break:break-word}
.editor table th{background:#f1f3f4;font-weight:600}
.editor table td:focus,.editor table th:focus{outline:2px solid #1a73e8;outline-offset:-2px}
.status-bar{display:flex;justify-content:space-between;align-items:center;padding:8px 12px;background:#f8f9fa;border-top:1px solid #dadce0;font-size:.8rem;color:#5f6368}
.help-text{font-size:.75rem}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;z-index:200;padding:16px}
.modal.hidden{display:none}
.modal-content{background:#fff;border-radius:12px;padding:20px;width:100%;max-width:320px;box-shadow:0 8px 24px rgba(0,0,0,.2)}
.modal-content h3{margin-bottom:16px;font-size:1.1rem}
.modal-content label{display:block;margin-bottom:12px;font-size:.95rem}
.modal-content input[type=number]{width:100%;padding:10px;border:1px solid #dadce0;border-radius:8px;font-size:1rem;margin-top:4px}
.modal-actions{display:flex;gap:10px;margin-top:16px}
.primary-btn,.secondary-btn{flex:1;padding:12px;border:none;border-radius:8px;font-size:.95rem;cursor:pointer;min-height:44px}
.primary-btn{background:#1a73e8;color:#fff}
.secondary-btn{background:#f1f3f4;color:#1a1a1a}
@media (max-width:480px){.tool-btn{padding:8px 8px;font-size:.8rem}.editor{padding:16px 12px}}
.editor table.active-table{outline:2px solid #1a73e8;outline-offset:2px}

/* Print / PDF Styles */
@media print {
  body * { visibility: hidden; }
  .editor, .editor * { visibility: visible; }
  .editor {
    position: absolute; left: 0; top: 0; width: 100%;
    padding: 0; margin: 0; box-shadow: none; border-radius: 0; font-size: 11pt;
  }
  .app-header, .toolbar, .status-bar, .modal { display: none !important; }
  .editor-wrapper { padding: 0; background: none; overflow: visible; }
  @page { size: A4 portrait; margin: 1.4cm; }
  table {
    width: 100% !important;
    border-collapse: collapse !important;
    border: 2px solid #000 !important;
  }
  th, td {
    border: 1.5px solid #000 !important;
    padding: 6px 5px !important;
  }
  th { background: #f0f0f0 !important; font-weight: bold !important; }
  .page-break { page-break-before: always; }
  .keep-one-page { page-break-inside: avoid !important; }
}
</style>
</head>
<body>
<div class="app-container">
  <header class="app-header">
    <h1>📄 মোবাইল ওয়ার্ড</h1>
    <div class="header-actions">
      <button id="btn-new" class="icon-btn" title="নতুন ডকুমেন্ট">🆕</button>
      <button id="btn-download" class="icon-btn primary" title="DOC ডাউনলোড">⬇️ DOC</button>
      <button id="btn-pdf" class="icon-btn pdf" title="PDF ডাউনলোড">📄 PDF</button>
    </div>
  </header>

  <div class="toolbar" id="toolbar">
    <div class="toolbar-row">
      <button class="tool-btn" data-cmd="bold" title="বোল্ড"><b>B</b></button>
      <button class="tool-btn" data-cmd="italic" title="ইটালিক"><i>I</i></button>
      <button class="tool-btn" data-cmd="underline" title="আন্ডারলাইন"><u>U</u></button>
      <button class="tool-btn" data-cmd="strikeThrough" title="স্ট্রাইক">S̶</button>
      <select id="font-size" class="tool-select" title="ফন্ট সাইজ">
        <option value="1">ছোট</option>
        <option value="2">সাধারণ</option>
        <option value="3" selected>মাঝারি</option>
        <option value="4">বড়</option>
        <option value="5">খুব বড়</option>
        <option value="6">বিশাল</option>
        <option value="7">সবচেয়ে বড়</option>
      </select>
      <input type="color" id="text-color" class="color-picker" title="টেক্সট রং" value="#000000">
      <input type="color" id="bg-color" class="color-picker" title="হাইলাইট রং" value="#ffff00">
    </div>
    <div class="toolbar-row">
      <button class="tool-btn" data-cmd="justifyLeft" title="বামে">⬅</button>
      <button class="tool-btn" data-cmd="justifyCenter" title="মাঝে">⬌</button>
      <button class="tool-btn" data-cmd="justifyRight" title="ডানে">➡</button>
      <button class="tool-btn" data-cmd="insertUnorderedList" title="বুলেট লিস্ট">• লিস্ট</button>
      <button class="tool-btn" data-cmd="insertOrderedList" title="নম্বর লিস্ট">1. লিস্ট</button>
      <button class="tool-btn" id="btn-table" title="টেবিল যোগ">📊 টেবিল</button>
      <button class="tool-btn" id="btn-pagebreak" title="নতুন পেজ">📄 পেজ ব্রেক</button>
    </div>
    <div class="toolbar-row table-tools" id="table-tools" style="display:none">
      <button class="tool-btn" id="add-row" title="রো যোগ">+ রো</button>
      <button class="tool-btn" id="add-col" title="কলাম যোগ">+ কলাম</button>
      <button class="tool-btn" id="del-row" title="রো মুছুন">- রো</button>
      <button class="tool-btn" id="del-col" title="কলাম মুছুন">- কলাম</button>
      <button class="tool-btn" id="set-col-width" title="কলাম সাইজ">সাইজ</button>
      <button class="tool-btn" id="btn-keep-one-page" title="এক পেজে রাখুন" style="background:#fff3cd;border-color:#ffc107;">📄 এক পেজে</button>
    </div>
  </div>

  <div class="editor-wrapper">
    <div id="editor" class="editor" contenteditable="true" spellcheck="true"
         data-placeholder="এখানে লিখুন... আপনার ডকুমেন্ট তৈরি করুন। টেবিল, ফরম্যাটিং সব সম্ভব।"></div>
  </div>

  <div class="status-bar">
    <span id="word-count">শব্দ: 0</span>
    <span class="help-text">টেবিল সিলেক্ট → "এক পেজে" বাটন চাপুন</span>
  </div>
</div>

<div id="table-modal" class="modal hidden">
  <div class="modal-content">
    <h3>টেবিল তৈরি করুন</h3>
    <label>সারি (Row): <input type="number" id="table-rows" min="1" max="60" value="3"></label>
    <label>কলাম (Column): <input type="number" id="table-cols" min="1" max="10" value="3"></label>
    <div class="modal-actions">
      <button id="create-table" class="primary-btn">তৈরি করুন</button>
      <button id="cancel-table" class="secondary-btn">বাতিল</button>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const editor = document.getElementById('editor');
  const toolbar = document.getElementById('toolbar');
  const tableTools = document.getElementById('table-tools');
  const tableModal = document.getElementById('table-modal');
  const wordCountEl = document.getElementById('word-count');

  editor.focus();

  document.querySelectorAll('.tool-btn[data-cmd]').forEach(btn => {
    btn.addEventListener('click', e => {
      e.preventDefault();
      document.execCommand(btn.dataset.cmd, false, null);
      editor.focus();
      updateActiveButtons();
    });
  });

  document.getElementById('font-size').addEventListener('change', e => {
    document.execCommand('fontSize', false, e.target.value);
    editor.focus();
  });

  document.getElementById('text-color').addEventListener('input', e => {
    document.execCommand('foreColor', false, e.target.value);
    editor.focus();
  });

  document.getElementById('bg-color').addEventListener('input', e => {
    document.execCommand('hiliteColor', false, e.target.value);
    document.execCommand('backColor', false, e.target.value);
    editor.focus();
  });

  document.getElementById('btn-new').addEventListener('click', () => {
    if (confirm('নতুন ডকুমেন্ট তৈরি করবেন? বর্তমান কাজ মুছে যাবে।')) {
      editor.innerHTML = '';
      editor.focus();
      updateWordCount();
      hideTableTools();
    }
  });

  // DOC Download
  document.getElementById('btn-download').addEventListener('click', () => {
    const content = editor.innerHTML.trim();
    if (!content || content === '<br>' || content === '<div><br></div>') {
      alert('ডকুমেন্ট খালি। আগে কিছু লিখুন বা টেবিল যোগ করুন।');
      return;
    }

    const fullHtml = `<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
<head>
<meta charset="UTF-8">
<meta name="ProgId" content="Word.Document">
<!--[if gte mso 9]>
<xml>
<w:WordDocument>
  <w:View>Print</w:View>
  <w:Zoom>100</w:Zoom>
</w:WordDocument>
</xml>
<![endif]-->
<style>
@page { size: A4 portrait; margin: 1.4cm; }
body { font-family: Arial, "Noto Sans Bengali", Kalpurush, sans-serif; font-size: 11pt; line-height: 1.4; margin: 0; padding: 0; }
table { width: 100% !important; border-collapse: collapse !important; border: 2px solid #000 !important; margin: 10px 0 !important; }
th, td { border: 1.5px solid #000 !important; padding: 6px 5px !important; vertical-align: top !important; }
th { background-color: #f0f0f0 !important; font-weight: bold !important; text-align: center !important; }
.keep-one-page { page-break-inside: avoid !important; }
.page-break { page-break-before: always; }
p { margin: 6px 0; }
</style>
</head>
<body>
${content}
</body>
</html>`;

    const blob = new Blob(['\ufeff' + fullHtml], { type: 'application/msword' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'document.doc';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    setTimeout(() => URL.revokeObjectURL(url), 1500);
  });

  // PDF
  document.getElementById('btn-pdf').addEventListener('click', () => {
    const content = editor.innerHTML.trim();
    if (!content || content === '<br>' || content === '<div><br></div>') {
      alert('ডকুমেন্ট খালি। আগে কিছু লিখুন বা টেবিল যোগ করুন।');
      return;
    }
    window.print();
  });

  // Page Break button
  document.getElementById('btn-pagebreak').addEventListener('click', () => {
    editor.focus();
    document.execCommand('insertHTML', false, '<div class="page-break" style="page-break-before:always; height:1px;">&nbsp;</div><p><br></p>');
  });

  // Table Modal
  document.getElementById('btn-table').addEventListener('click', () => {
    tableModal.classList.remove('hidden');
  });
  document.getElementById('cancel-table').addEventListener('click', () => {
    tableModal.classList.add('hidden');
  });

  document.getElementById('create-table').addEventListener('click', () => {
    let rows = parseInt(document.getElementById('table-rows').value) || 3;
    let cols = parseInt(document.getElementById('table-cols').value) || 3;
    if (rows < 1) rows = 1;
    if (cols < 1) cols = 1;
    if (rows > 60) rows = 60;
    if (cols > 10) cols = 10;
    insertTable(rows, cols);
    tableModal.classList.add('hidden');
  });

  function insertTable(rows, cols) {
    let html = '<table border="1" cellpadding="5" cellspacing="0" style="width:100%;border-collapse:collapse;border:2px solid #000;">';
    for (let i = 0; i < rows; i++) {
      html += '<tr>';
      for (let j = 0; j < cols; j++) {
        if (i === 0) {
          html += `<th contenteditable="true" style="border:1.5px solid #000;padding:6px 5px;background:#f1f3f4;font-weight:600;text-align:center;">হেডার ${j+1}</th>`;
        } else {
          html += `<td contenteditable="true" style="border:1.5px solid #000;padding:6px 5px;">&nbsp;</td>`;
        }
      }
      html += '</tr>';
    }
    html += '</table><p><br></p>';

    editor.focus();
    const sel = window.getSelection();
    if (sel.rangeCount > 0) {
      const range = sel.getRangeAt(0);
      range.deleteContents();
      const temp = document.createElement('div');
      temp.innerHTML = html;
      const frag = document.createDocumentFragment();
      let node;
      while (node = temp.firstChild) frag.appendChild(node);
      range.insertNode(frag);
    } else {
      editor.innerHTML += html;
    }
    editor.focus();
    updateWordCount();
  }

  let currentTable = null;

  editor.addEventListener('click', e => {
    const cell = e.target.closest('td, th');
    if (cell) {
      currentTable = cell.closest('table');
      showTableTools();
      document.querySelectorAll('.editor table').forEach(t => t.classList.remove('active-table'));
      if (currentTable) currentTable.classList.add('active-table');
    } else {
      hideTableTools();
      document.querySelectorAll('.editor table').forEach(t => t.classList.remove('active-table'));
      currentTable = null;
    }
  });

  function showTableTools() { tableTools.style.display = 'flex'; }
  function hideTableTools() { tableTools.style.display = 'none'; }

  // ========== এক পেজে রাখুন বাটন ==========
  document.getElementById('btn-keep-one-page').addEventListener('click', () => {
    if (!currentTable) {
      alert('আগে টেবিলের ভিতরে ক্লিক করুন।');
      return;
    }

    // এক পেজে রাখার জন্য ক্লাস যোগ
    currentTable.classList.add('keep-one-page');
    currentTable.style.pageBreakInside = 'avoid';

    // সারি সংখ্যা অনুযায়ী ফন্ট সাইজ ছোট করা
    const rowCount = currentTable.rows.length;
    let fontSize = '12px';
    let padding = '6px 5px';

    if (rowCount > 40) {
      fontSize = '8px';
      padding = '3px 2px';
    } else if (rowCount > 30) {
      fontSize = '9px';
      padding = '4px 3px';
    } else if (rowCount > 20) {
      fontSize = '10px';
      padding = '5px 4px';
    } else if (rowCount > 12) {
      fontSize = '11px';
      padding = '5px 4px';
    }

    // সব সেলে ফন্ট ও প্যাডিং অ্যাপ্লাই
    const cells = currentTable.querySelectorAll('td, th');
    cells.forEach(cell => {
      cell.style.fontSize = fontSize;
      cell.style.padding = padding;
      cell.style.lineHeight = '1.25';
    });

    alert('টেবিল এখন এক পেজে থাকবে।\nসারি বেশি হলে লেখা ছোট করা হয়েছে।\nPDF বা DOC ডাউনলোড করলে দেখতে পাবেন।');
    editor.focus();
  });

  document.getElementById('add-row').addEventListener('click', () => {
    if (!currentTable) return;
    const cols = currentTable.rows[0].cells.length;
    const newRow = currentTable.insertRow(-1);
    for (let i = 0; i < cols; i++) {
      const cell = newRow.insertCell(i);
      cell.contentEditable = true;
      cell.style.border = '1.5px solid #000';
      cell.style.padding = '6px 5px';
      cell.innerHTML = '&nbsp;';
    }
    editor.focus();
  });

  document.getElementById('add-col').addEventListener('click', () => {
    if (!currentTable) return;
    const rows = currentTable.rows;
    for (let i = 0; i < rows.length; i++) {
      if (i === 0) {
        const th = document.createElement('th');
        th.contentEditable = true;
        th.style.cssText = 'border:1.5px solid #000;padding:6px 5px;background:#f1f3f4;font-weight:600;text-align:center';
        th.innerHTML = 'হেডার';
        rows[i].appendChild(th);
      } else {
        const cell = rows[i].insertCell(-1);
        cell.contentEditable = true;
        cell.style.cssText = 'border:1.5px solid #000;padding:6px 5px';
        cell.innerHTML = '&nbsp;';
      }
    }
    editor.focus();
  });

  document.getElementById('del-row').addEventListener('click', () => {
    if (!currentTable || currentTable.rows.length <= 1) {
      alert('কমপক্ষে একটি সারি রাখতে হবে।');
      return;
    }
    currentTable.deleteRow(-1);
    editor.focus();
  });

  document.getElementById('del-col').addEventListener('click', () => {
    if (!currentTable || currentTable.rows[0].cells.length <= 1) {
      alert('কমপক্ষে একটি কলাম রাখতে হবে।');
      return;
    }
    for (let i = 0; i < currentTable.rows.length; i++) {
      currentTable.rows[i].deleteCell(-1);
    }
    editor.focus();
  });

  document.getElementById('set-col-width').addEventListener('click', () => {
    if (!currentTable) return;
    const width = prompt('কলামের প্রস্থ লিখুন (যেমন: 100px বা 30%):', '120px');
    if (width) {
      const sel = window.getSelection();
      let cell = null;
      if (sel.rangeCount > 0) {
        const node = sel.anchorNode;
        cell = node.nodeType === 1 ? node.closest('td,th') : (node.parentElement ? node.parentElement.closest('td,th') : null);
      }
      if (cell) {
        const idx = cell.cellIndex;
        for (let i = 0; i < currentTable.rows.length; i++) {
          if (currentTable.rows[i].cells[idx]) {
            currentTable.rows[i].cells[idx].style.width = width;
          }
        }
      } else {
        currentTable.style.width = width;
      }
    }
    editor.focus();
  });

  function updateWordCount() {
    const text = editor.innerText || '';
    const words = text.trim().split(/\s+/).filter(w => w.length > 0).length;
    wordCountEl.textContent = `শব্দ: ${words}`;
  }

  editor.addEventListener('input', updateWordCount);
  editor.addEventListener('keyup', updateWordCount);

  function updateActiveButtons() {
    document.querySelectorAll('.tool-btn[data-cmd]').forEach(btn => {
      if (document.queryCommandState(btn.dataset.cmd)) btn.classList.add('active');
      else btn.classList.remove('active');
    });
  }

  editor.addEventListener('keyup', updateActiveButtons);
  editor.addEventListener('mouseup', updateActiveButtons);

  toolbar.addEventListener('mousedown', e => {
    if (e.target.tagName !== 'SELECT' && e.target.tagName !== 'INPUT') e.preventDefault();
  });

  updateWordCount();
});
</script>
</body>
</html>